---
import "@fontsource/newsreader/400.css";
import "@fontsource/newsreader/400-italic.css";
import "@fontsource/newsreader/700.css";
import "@fontsource/cabin/400.css";
import "@fontsource/cabin/700.css";
import "@fontsource/monaspace-argon/400.css";
import "@fontsource/monaspace-argon/400-italic.css";

import { SITE_NAME } from "@tsukue/config";
import type { AlternateLink } from "../lib/posts";

import "../styles/global.css";
import "../styles/tokens.css";
import "../styles/desk.css";
import "../styles/cards.css";
import "../styles/article.css";
import "../styles/mdx.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: string;
  alternates?: AlternateLink[];
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  lang = "en",
  canonical,
  alternates = [],
  ogType = "website",
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternates.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.hreflang}
          href={alternate.href}
        />
      ))
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body data-lang={lang}>
    <!-- Inline so the paper texture costs no request. feDiffuseLighting is
         what makes it read as rough stock rather than flat noise: the
         turbulence is lit from an angle instead of merely tinting. -->
    <svg class="filter-defs" aria-hidden="true" focusable="false">
      <!-- The default filter region is the bounding box grown by 10% on every
           side, which spills a lit halo past each card onto the desk. Pin it
           to the element's own box. -->
      <filter id="rough-paper" x="0" y="0" width="100%" height="100%">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.04"
          numOctaves="5"
          result="noise"></feTurbulence>
        <feDiffuseLighting in="noise" lighting-color="#fff" surfaceScale="2">
          <feDistantLight azimuth="45" elevation="60"></feDistantLight>
        </feDiffuseLighting>
      </filter>
    </svg>

    <slot />
  </body>
</html>
