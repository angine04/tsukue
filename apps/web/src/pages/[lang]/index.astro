---
import { SITE_DESCRIPTION } from "@tsukue/config";
import DeskApp from "../../components/desk/DeskApp";
import Layout from "../../layouts/Layout.astro";
import {
  absoluteUrl,
  buildDeskItems,
  listLocalizedLangs,
  loadPosts,
} from "../../lib/posts";

export async function getStaticPaths() {
  const entries = await loadPosts();
  return listLocalizedLangs(entries).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const entries = await loadPosts();
const items = buildDeskItems(entries, lang);
---

<Layout
  description={SITE_DESCRIPTION}
  lang={lang}
  canonical={absoluteUrl(Astro.url.pathname)}
>
  <DeskApp client:load items={items} lang={lang} />
</Layout>
