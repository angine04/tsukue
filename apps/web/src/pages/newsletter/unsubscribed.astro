---
import { homePath, ui } from "@tsukue/config";
import Layout from "../../layouts/Layout.astro";

const lang = "en";
const title = ui("newsletter.unsubscribed.title", lang);
---

{
  /* The receipt for leaving, reached from a link in an email. See confirmed.astro. */
}
<Layout title={title} lang={lang} noindex>
  <main class="desk">
    <div class="sheet-surface sheet-notice">
      <h1>{title}</h1>
      <p>{ui("newsletter.unsubscribed.body", lang)}</p>
      <a class="sheet-back" href={homePath(lang)}>{ui("nav.back", lang)}</a>
    </div>
  </main>
</Layout>
