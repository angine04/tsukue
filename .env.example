# Build-time values for the web app. Copy to `.env` (gitignored):
#
#   cp .env.example .env
#
# Vite reads this file from the repository root — `astro.config.mjs` sets
# `envDir: "../../"` so the web build and Wrangler share one env file instead of
# two. Only `PUBLIC_`-prefixed values reach the browser; anything else here is
# build-side and never ships.
#
# The Cloudflare credentials used by `pnpm deploy:cf` do not belong here; they
# belong in your shell or CI secrets. See the README's Deployment section.

# The Turnstile *site* key is public: the widget is rendered by the browser from
# a key baked into the page, and no Function reads it. The matching secret is
# `TURNSTILE_SECRET` in `.dev.vars`.
#
# Turnstile publishes a test pair that needs no account, which is what CI and a
# local checkout should use:
#   1x00000000000000000000AA  always passes
#   2x00000000000000000000AB  always fails
#   3x00000000000000000000FF  forces an interactive challenge
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
