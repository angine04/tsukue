# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
# Wrangler's local secret store. Holds the same secrets as production, so it
# needs the same protection as .env — it is not covered by the patterns above.
.dev.vars
.dev.vars.*
# …except the example, which holds no secrets and is the only way a clone knows
# what the file is supposed to contain.
!.dev.vars.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# wrangler
.wrangler/

# test artifacts
test-results/
playwright-report/

# coverage
coverage/

.env

# playwright: artifacts from a run, not sources
test-results/
playwright-report/
blob-report/
