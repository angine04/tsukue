---
import { SITE_DESCRIPTION, postPath, ui } from "@tsukue/config";
import Layout from "../../layouts/Layout.astro";
import {
  absoluteUrl,
  listLocalizedLangs,
  loadPosts,
  toPostMeta,
} from "../../lib/posts";

export async function getStaticPaths() {
  const entries = await loadPosts();
  return listLocalizedLangs(entries).map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const entries = await loadPosts();
const posts = entries
  .filter((entry) => entry.data.lang === lang)
  .map(toPostMeta);
---

<Layout
  description={SITE_DESCRIPTION}
  lang={lang}
  canonical={absoluteUrl(Astro.url.pathname)}
>
  <div class="desk min-h-screen">
    <nav class="desk-index" aria-label={ui("nav.home", lang)}>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={postPath(post)}>
                <h2>{post.title}</h2>
                <p>{post.description}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>
