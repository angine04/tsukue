---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

{
  /* An Aside holds supporting context that should remain secondary to the prose. */
}
<aside class="mdx-aside border-l-2 border-line-strong pl-5 pr-2 text-muted">
  {title && <p class="mb-2 font-serif text-lg italic text-ink">{title}</p>}
  <div class="font-sans leading-[1.65]"><slot /></div>
</aside>
